        </div>
    </div>
  
    <div class="modal fade" id="AdminLoginShopModal" tabindex="-1" aria-labelledby="AdminLoginShopModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <i class="bi bi-person"> ورود به بخش ادمین فروشگاه</i>
                    <form asp-controller="account" asp-action="loginadmin" method="post">
                        <input type="hidden" name="Dashboard" value="adminShop" />
                        <div class="mb-3">
                            <input name="Password" type="password" placeholder="رمز عبور ادمین خود را وارد کنید">
                        </div>
                        <button type="submit" class="m-3">
                            ورود
                        </button>
                    </form>
                    <a href="#" data-bs-toggle="modal" data-bs-target="#AdminResetPasswordModal" class="m-3">بازیابی رمز عبورادمین</a>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="AdminResetPasswordModal" tabindex="-1" aria-labelledby="AdminResetPasswordModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-body">
                    <i class="bi bi-key"> بازیابی رمز عبور</i>
                    <form asp-controller="Account" asp-action="ResetPassword" method="post">
                        <div class="mb-3">
                            <input type="text" name="EmailOrMobile" placeholder="شماره موبایل یا ایمیل خود را وارد کنید" class="form-control" required>
                        </div>
                        <button type="submit" class="m-3">
                            بازیابی رمز عبور
                        </button>
                    </form>
                    @if (User.Identity.IsAuthenticated && User.HasClaim(c => c.Type == "IsEmployeeSite" && c.Value.ToLower() == "true"))
                    {
                        <a href="#" data-bs-toggle="modal" data-bs-target="#AdminLoginSiteModal" class="m-3">بازگشت به صفحه ادمین سایت'</a>
                    }
                    @if (User.Identity.IsAuthenticated && User.HasClaim(c => c.Type == "IsEmployeeShop" && c.Value.ToLower() == "true"))
                    {
                        <a href="#" data-bs-toggle="modal" data-bs-target="#AdminLoginShopModal" class="m-3">بازگشت به صفحه ادمین فروشگاه</a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- End Modal Box -->



