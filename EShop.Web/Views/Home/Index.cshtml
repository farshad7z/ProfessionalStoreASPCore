                            <a class="btn hvr-hover" href="#">پیراهن</a>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="shop-cat-box">
                            <img class="img-fluid" src="~/Public/images/category/wallet-img.jpg" alt="کیف" />
                            <a class="btn hvr-hover" href="#">کیف پول</a>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="shop-cat-box">
                            <img class="img-fluid" src="~/Public/images/category/women-shoes-img.jpg " alt="شلوار جین" />
                            <a class="btn hvr-hover" href="#">کفش زنانه</a>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="shop-cat-box">
                            <img class="img-fluid" src="~/Public/images/category/women-bag-img.jpg" alt="کیف" />
                            <a class="btn hvr-hover" href="#">کیف</a>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
