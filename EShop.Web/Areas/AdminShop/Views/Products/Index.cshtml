@model IEnumerable<Product>

<h2>مدیریت محصولات</h2>

<p class="mt-3">
    <a class="btn btn-primary" asp-area="adminshop" asp-controller="products" asp-action="create">افزودن محصول جدید</a>
</p>


<div class="table-responsive">
    <div id="dataTables-product_wrapper" class="dataTables_wrapper form-inline" role="grid">
        <div class="row">
            <div class="col-sm-6">
                <div class="dataTables_length" id="dataTables-example_length">
                    <label>
                        <select name="dataTables-example_length" aria-controls="dataTables-example" class="form-control input-sm">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        تعداد صفحات
                    </label>
                </div>
            </div>
            <div class="col-sm-6">
                <div id="dataTables-product_filter" class="dataTables_filter">
                    <label>
                        جستجو<input type="search" class="form-control input-sm" aria-controls="dataTables-product">
                    </label>
                </div>
            </div>
        </div>
        <table class="table table-striped table-bordered table-hover dataTable no-footer" id="dataTables-example" aria-describedby="dataTables-example_info">
            <thead>
                <tr role="row">
                    <th>ردیف</th>
                    <th class="sorting" tabindex="0" aria-controls="dataTables-product"
                        rowspan="1" colspan="1"
                        aria-label="Rendering engine: activate to sort column ascending">
                        نام محصول
                    </th>
                    <th class="sorting" tabindex="0" aria-controls="dataTables-product"
                        rowspan="1" colspan="1"
                        aria-label="Platform(s): activate to sort column ascending">
                        گروه های این محصول
                    </th>
                    <th class="sorting" tabindex="0" aria-controls="dataTables-product"
                        rowspan="1" colspan="1"
                        aria-label="Platform(s): activate to sort column ascending">
                        قیمت
                    </th>
                    <th class="sorting" tabindex="0" aria-controls="dataTables-product"
                        rowspan="1" colspan="1"
                        aria-label="Platform(s): activate to sort column ascending">
                        تاریخ ایجاد
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>

                <tr class="gradeA odd">
                    <td class="">1</td>
                    <td class=" ">z</td>
                    <td class=" ">کتاب</td>
                    <td class="center">1000</td>
                    <td class="center sorting_1">1403/05/01</td>
                    <td>
                        <a class="btn btn-light btn-sm" href="@Url.Action("ProductFeatures"/* , new {id=item.ProductID} */)">ویژگی های محصول</a>
                        <a class="btn btn-info btn-sm" href="@Url.Action("Galleries"/* , new {id=item.ProductID} */)">گالری محصول</a>
                        <a class="btn btn-warning btn-sm" href="@Url.Action("Edit"/*,  new {id=item.ProductID} */)">ویرایش محصول</a>
                        <a class="btn btn-danger btn-sm" href="@Url.Action("Delete"/* , new {id=item.ProductID} */)">حذف محصول</a>

                    </td>
                </tr>
                @{
                    int i = 0;

                    foreach (var product in Model)
                    {
                        <tr class="gradeA odd">
                            <td class="">@i++</td>
                            <td class=" ">@product.Name</td>
                            <td class=" ">1111</td>
                            <td class="center">@product.Price</td>
                            <td class="center sorting_1">@product.CreatedAt</td>
                            <td>
                                <a class="btn btn-light btn-sm" href="@Url.Action("ProductFeatures"/* , new {id=item.ProductID} */)">ویژگی های محصول</a>
                                <a class="btn btn-info btn-sm" href="@Url.Action("Galleries"/* , new {id=item.ProductID} */)">گالری محصول</a>
                                <a class="btn btn-warning btn-sm" href="@Url.Action("Edit"/*,  new {id=item.ProductID} */)">ویرایش محصول</a>
                                <a class="btn btn-danger btn-sm" href="@Url.Action("Delete"/* , new {id=item.ProductID} */)">حذف محصول</a>

                            </td>
                        </tr>

                    }
                }
            </tbody>
        </table><div class="row"><div class="col-sm-6"><div class="dataTables_info" id="dataTables-example_info" role="alert" aria-live="polite" aria-relevant="all">Showing 1 to 10 of 57 entries</div></div><div class="col-sm-6"><div class="dataTables_paginate paging_simple_numbers" id="dataTables-example_paginate"><ul class="pagination"><li class="paginate_button previous disabled" aria-controls="dataTables-example" tabindex="0" id="dataTables-example_previous"><a href="#">Previous</a></li><li class="paginate_button active" aria-controls="dataTables-example" tabindex="0"><a href="#">1</a></li><li class="paginate_button " aria-controls="dataTables-example" tabindex="0"><a href="#">2</a></li><li class="paginate_button " aria-controls="dataTables-example" tabindex="0"><a href="#">3</a></li><li class="paginate_button " aria-controls="dataTables-example" tabindex="0"><a href="#">4</a></li><li class="paginate_button " aria-controls="dataTables-example" tabindex="0"><a href="#">5</a></li><li class="paginate_button " aria-controls="dataTables-example" tabindex="0"><a href="#">6</a></li><li class="paginate_button next" aria-controls="dataTables-example" tabindex="0" id="dataTables-example_next"><a href="#">Next</a></li></ul></div></div></div>
    </div>
</div>
