<div class="row">
    <div class="col-12">
        <div class="card my-4">
            <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3">
                    <h6 class="text-white text-capitalize ps-3">مدیریت محصولات</h6>
                </div>
            </div>
            <div class="card-body px-0 pb-2">
                <div class="table-responsive p-0">
                    <table class="table align-items-center mb-0">
                        <thead>
                            <tr class="text-center">
                                <th>ردیف</th>
                                <th>تصویر بند انگشتی</th>
                                <th>نام محصول</th>
                                <th>قیمت اصلی</th>
                                <th>قیمت تخفیف‌خورده</th>
                                <th>قیمت نهایی</th>
                                <th>دسته‌بندی محصول</th>
                                <th>وضعیت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int Count = 0;
                            }


                            @foreach (var product in Model)
                            {
                                Count++;
                                <!-- افزایش شمارنده -->
                                <tr>
                                    <td class="text-center">
                                        @Count <!-- نمایش شماره ردیف -->
                                    </td>
                                    <td class="text-center">
                                        <!-- نمایش تصویر بند انگشتی -->
                                        <img src="@Url.Content($"{ViewBag.ImagePath}/{"thumbnail_"+product.ProductImageName}")"
                                             class="avatar avatar-sm me-3 border-radius-lg"
                                             alt="@product.Name">
                                    </td>
                                    <td class="text-center">
                                        <p class="text-xs font-weight-bold mb-0">@product.Name</p>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-secondary text-xs font-weight-bold">@product.Price.ToString("N0") تومان</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-secondary text-xs font-weight-bold">
                                            @(product.DiscountedPrice.HasValue ? product.DiscountedPrice.Value.ToString("N0") : "ندارد")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-secondary text-xs font-weight-bold">@product.FinalPrice.ToString("N0") تومان</span>
                                    </td>

                                    <td class="text-center">
                                        <p class="text-xs font-weight-bold mb-0">
                                            @string.Join(", ", product.ProductSelectCategory.Select(pc => pc.ProductCategory.Name))
                                        </p>
                                    </td>
                                    <td class="text-center">
                                        @if (product.IsPublished)
                                        {
                                            <span class="badge badge-sm bg-gradient-success">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-sm bg-gradient-danger">غیرفعال</span>
                                        }
                                    </td>
                                    <td class="text-center">
                             

                                        <a href="/adminshop/products/galleries/@product.Id" class="text-info font-weight-bold text-xs ms-2" data-toggle="tooltip" title="گالری">
                                            <i class="bi bi-image"></i>
                                        </a>
                                        <a href="@Url.Action("manageproductfeatures", "products", new { id = product.Id })" class="text-info font-weight-bold text-xs ms-2" data-toggle="tooltip" title="افزودن ویژگی">
                                            <i class="bi bi-bookmark-plus-fill"></i>
                                        </a>
                                        <a href="#"@* /Admin/Products/Variants/@product.Id *@ class="text-warning font-weight-bold text-xs ms-2" data-toggle="tooltip" title="واریانت‌ها">
                                            <i class="bi bi-box"></i>
                                        </a>
                                        <a href="@Url.Action("SEO", "Products", new { productId = product.Id, productName = product.Name })"
                                           class="text-primary font-weight-bold text-xs ms-2"
                                           data-toggle="tooltip"
                                           title="سئو">
                                            <i class="bi bi-search"></i>
                                        </a>
                                        <a href="/adminshop/products/edit/@product.Id" class="text-secondary font-weight-bold text-xs" data-toggle="tooltip" title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="#" class="text-danger font-weight-bold text-xs ms-2" data-toggle="tooltip" title="حذف" onclick="return confirm('آیا مطمئن هستید؟');">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>