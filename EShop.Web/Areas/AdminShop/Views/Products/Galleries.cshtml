@using EShop.Core.DTOs.ViewModels.Admin.Product
@model AdminProductGalleryViewModel

@{
    ViewBag.Title = "گالری تصاویر";

}
<h1>@Model.ProductId</h1>
<div class="row">
    <div class="col-md-4">
        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <h2>گالری تصاویر</h2>
            <hr />

            <form asp-action="Galleries" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ProductId)

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="Title" class="control-label col-md-2"></label>
                    <div class="col-md-10">
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="ImageFile" class="control-label"></label>
                    <div class="col-md-10">
                        <input type="file" asp-for="ImageFile" class="form-control"
                               accept=".jpg,.jpeg,.png,.gif" />
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 mt-3 col-md-10">
                        <input type="submit" value="ثبت تصویر" class="btn btn-success" />
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-8">
        <div id="product-galleries">
            <!-- Partial View در اینجا قرار می‌گیرد -->
        </div>

    </div>

    <!--** End List Gallery From Action ListGalleryGroup**-->
</div>

<div>
    <a asp-action="Index" class="btn btn-info">بازگشت به صفحه مدیریت محصولات</a>
</div>



@section Scripts {
    <script>

        function Delete(id) {
            if (confirm("آیا از حذف مطمئن هستید؟")) {
                fetch(`/AdminShop/Products/DeleteGallery?id=${id}`)
                .then(response => {
                        if (!response.ok) {
                            throw new Error("Network response was not ok");
                        }
                        return response.text();
                    })
                    .then(() => {
                        // پیدا کردن المان مربوط به ردیف آیتم
                        const element = document.getElementById(`trIdGallery_${id}`);
                        if (element) {
                            // تنظیم انیمیشن fade-out با CSS
                            element.style.transition = "opacity 0.5s ease-out";
                            element.style.opacity = 0;
                            // پس از پایان انیمیشن، المان حذف شود
                            setTimeout(() => {
                                element.remove();
                            }, 500);
                        }
                    })
                    .catch(error => {
                        console.error("Error:", error);
                        alert("خطا در حذف آیتم.");
                    });
            }
        }



        const productId = @Html.Raw(Json.Serialize(Model.ProductId));
        console.log("ProductId:", productId);

        function loadProductGalleries(productId) {
            fetch(`/AdminShop/Products/ListGalleryProduct?productId=${productId}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                    return response.text();
            })
            .then(html => {
                document.getElementById('product-galleries').innerHTML = html;
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Failed to load product galleries.');
                });
        }

        // فراخوانی تابع هنگام بارگذاری صفحه
        document.addEventListener('DOMContentLoaded', () => {
            if (productId) {
                loadProductGalleries(productId);
            } else {
                console.error('Product ID is not defined.');
                alert('Product ID is missing. Unable to load galleries.');
            }
        });
    </script>
}
