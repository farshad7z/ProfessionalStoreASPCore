@using EShop.Core.DTOs.ViewModels.Admin.Product
@model AdminManageProductFeaturesViewModel
@using EShop.Core.Entities.Enums
@using Newtonsoft.Json

<div class="card">
    <div class="card-header">
        <h5>مدیریت ویژگی های محصول: @Model.ProductName</h5>
    </div>
    <div class="card-body">
        <!-- لیست ویژگیهای ذخیرهشده -->
        <h6>ویژگی های ثبت‌شده:</h6>
        <table class="table table-striped" id="saved-features-table">
            <thead>
                <tr>
                    <th>نام ویژگی</th>
                    <th>مقدار</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var feature in Model.SavedProductFeatures)
                {
                    <tr id="saved-feature-row-@feature.FeatureId">
                        <td>@feature.FeatureName</td>
                        <td>
                            @switch (feature.FeatureType)
                            {
                                case EShop.Core.Entities.Enums.FeatureType.Range:
                                    <span>@feature.RangeMin - @feature.RangeMax</span>
                                    break;

                                case EShop.Core.Entities.Enums.FeatureType.Boolean:
                                    <span>@(feature.Value == "true" ? "دارد" : "ندارد")</span>
                                    break;

                                case EShop.Core.Entities.Enums.FeatureType.Color:
                                    var colorItems = ViewBag.ProductColors as List<ColorItem>;
                                    var colorItem = colorItems?.FirstOrDefault(c => c.Name == feature.Value);
                                    @if (colorItem != null)
                                    {
                                        <span style="background:@colorItem.ColorCode; padding:2px 8px; border-radius:4px">
                                            @colorItem.Title
                                        </span>
                                    }
                                    else
                                    {
                                        <span>نامشخص</span>
                                    }
                                    break;

                                default:
                                    <span>@feature.Value</span>
                                    break;
                            }
                        </td>
                        <td>
                            <button onclick="deleteFeature(@feature.FeatureId)"
                                    class="btn btn-sm btn-danger">
                                حذف
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- لیست ویژگیهای موجود -->
        <h6>افزودن ویژگی جدید:</h6>
        <table class="table table-striped" id="available-features-table">
            <thead>
                <tr>
                    <th>نام ویژگی</th>
                    <th>نوع ویژگی</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var feature in Model.Features)
                {
                    <tr id="feature-row-@feature.FeatureId">
                        <td>@feature.FeatureName</td>
                        <td>@feature.FeatureType</td>
                        <td>
                            <button onclick="addFeature(
                                @feature.FeatureId,
                                '@feature.FeatureName',
                                '@feature.FeatureType.ToString().ToLower()')"
                                    class="btn btn-sm btn-primary">
                                افزودن
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        const productColors = @Html.Raw(JsonConvert.SerializeObject(ViewBag.ProductColors));
        const colorMap = Object.fromEntries(
            productColors.map(c => [c.Name, c.Title])
        );

          async function addFeature(featureId, featureName, featureType) {
            try {
                let value = null;
                const requestData = {
                    ProductId: @Model.ProductId,
                    FeatureId: featureId,
                    Value: ''
                };

                // پردازش بر اساس نوع ویژگی
                switch (featureType.toLowerCase()) {
                    case 'range':
                        value = await handleRangeFeature(featureName);
                        break;
                    case 'boolean':
                        value = await handleBooleanFeature(featureName);
                        break;
                    case 'color':
                        value = await handleColorFeature(featureName);
                        break;
                    default:
                        value = await handleTextFeature(featureName);
                }

                if (!value) return;

                requestData.Value = value;

                const response = await fetch('@Url.Action("AddProductFeature", "Products", new { area = "AdminShop" })', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify(requestData)
                });

                const result = await response.json();

                if (result.isSuccess) {
                    await updateUIAfterAdd(featureId, featureName, featureType, value);
                    showSuccessToast(result.message || 'ویژگی با موفقیت اضافه شد');
                } else {
                    showErrorToast(result.message || 'خطا در افزودن ویژگی');
                }

            } catch (error) {
                console.error('Error:', error);
                showErrorToast('خطای ارتباط با سرور');
            }
        }


        // توابع کمکی
        async function handleRangeFeature(featureName) {
            const { value } = await Swal.fire({
                title: `محدوده ${featureName}`,
                html: `
                    <input type="number" id="swal-range-min" class="swal2-input" placeholder="حداقل" step="0.1">
                    <input type="number" id="swal-range-max" class="swal2-input" placeholder="حداکثر" step="0.1">
                `,
                preConfirm: () => {
                    const min = $('#swal-range-min').val();
                    const max = $('#swal-range-max').val();

                    if (!min || !max) {
                        Swal.showValidationMessage('هر دو فیلد الزامی است');
                        return null;
                    }

                    if (parseFloat(min) >= parseFloat(max)) {
                        Swal.showValidationMessage('حداقل باید کمتر از حداکثر باشد');
                        return null;
                    }

                    return `${min}-${max}`;
                }
            });
            return value;
        }

        async function handleBooleanFeature(featureName) {
            const { value } = await Swal.fire({
                title: `وضعیت ${featureName}`,
                input: 'radio',
                inputOptions: {
                    'true': 'دارد',
                    'false': 'ندارد'
                },
                inputValidator: (value) => !value && 'لطفاً یک گزینه انتخاب کنید'
            });
            return value ? 'true' : null;
        }

          async function handleColorFeature(featureName) {
            const inputOptions = {};
            productColors.forEach(c => {
                inputOptions[c.Name] = c.Title;
            });

            const { value } = await Swal.fire({
                title: `رنگ ${featureName}`,
                input: 'select',
                inputOptions: inputOptions,
                customClass: {
                    popup: 'swal2-color-popup'
                },
                inputValidator: (value) => !value && 'لطفاً یک رنگ انتخاب کنید'
            });
            return value;
        }


        async function handleTextFeature(featureName) {
            const { value } = await Swal.fire({
                title: `مقدار ${featureName}`,
                input: 'text',
                inputValidator: (value) => !value && 'لطفاً مقدار را وارد کنید'
            });
            return value;
        }

        async function updateUIAfterAdd(featureId, featureName, featureType, value) {
            const formattedValue = formatFeatureValue(featureType, value);

            $('#saved-features-table tbody').append(`
                <tr id="saved-feature-row-${featureId}">
                    <td>${featureName}</td>
                    <td>${formattedValue}</td>
                    <td>
                        <button onclick="deleteFeature(${featureId})"
                                class="btn btn-sm btn-danger">
                            حذف
                        </button>
                    </td>
                </tr>
            `);
        }

        function formatFeatureValue(type, value) {
            switch (type.toLowerCase()) {
                case 'range':
                    return value.replace('-', ' - ');
                case 'boolean':
                    return value === 'true' ? 'دارد' : 'ندارد';
                case 'color':
                    return colorMap[value] || value;
                default:
                    return value;
            }
        }

        // تابع حذف ویژگی
        async function deleteFeature(featureId) {
            const { isConfirmed } = await Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: 'این عمل قابل بازگشت نیست!',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف شود',
                cancelButtonText: 'لغو',
                reverseButtons: true
            });

            if (!isConfirmed) return;

            try {
                const response = await fetch(
                    `@Url.Action("DeleteProductFeature", "Products", new { area = "AdminShop" })/${@Model.ProductId}/${featureId}`,
                    {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                        }
                    }
                );

                const result = await response.json();

                if (result.success) {
                    $(`#saved-feature-row-${featureId}`).remove();
                    showSuccessToast('ویژگی با موفقیت حذف شد');
                } else {
                    throw new Error(result.message);
                }

            } catch (error) {
                console.error('Error:', error);
                showErrorToast(error.message || 'خطا در حذف ویژگی');
            }
        }

        // توابع نمایش نوتیفیکیشن
        function showSuccessToast(message) {
            Swal.fire({
                toast: true,
                position: 'top-start',
                icon: 'success',
                title: message,
                showConfirmButton: false,
                timer: 3000
            });
        }

        function showErrorToast(message) {
            Swal.fire({
                toast: true,
                position: 'top-start',
                icon: 'error',
                title: message,
                showConfirmButton: false,
                timer: 5000
            });
        }
    </script>

    <style>
        .swal2-select option {
            direction: rtl;
            text-align: right;
        }
    </style>
}