    <script>
        document.querySelector('input[name="ImageProduct"]').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const previewImage = document.getElementById('previewImage');
                    previewImage.src = e.target.result;
                    previewImage.style.display = 'block';
                };
                reader.readAsDataURL(file);
            }
        });
    </script>

    <script>
        $(document).ready(function () {
            // مدیریت نمایش و مخفی‌سازی زیردسته‌ها
            $(document).on("change", ".category-checkbox", function () {
                var categoryId = $(this).val();
                var subCategories = $(this).closest("li").children("ul");
                var radioButton = $("input[name='MainCategoryId'][value='" + categoryId + "']");

                if ($(this).is(":checked")) {
                    subCategories.slideDown();
                    radioButton.prop("disabled", false);

                    // اگر هیچ رادیویی انتخاب نشده و این اولین انتخاب است، به طور خودکار دسته اصلی تنظیم شود
                    if ($("input[name='MainCategoryId']:checked").length === 0) {
                        radioButton.prop("checked", true);
                    }
                } else {
                    subCategories.slideUp();
                    subCategories.find("input[type='checkbox']")
                        .prop("checked", false)
                        .trigger("change");

                    // اگر دسته اصلی بود و چک‌باکس آن برداشته شد، رادیو باتن هم باید غیرفعال شود
                    radioButton.prop("disabled", true);
                    if (radioButton.is(":checked")) {
                        radioButton.prop("checked", false);

                        // یک دسته دیگر را به عنوان دسته اصلی انتخاب کنیم (اگر دسته‌ای انتخاب شده باشد)
                        var firstChecked = $(".category-checkbox:checked").first();
                        if (firstChecked.length > 0) {
                            var firstCheckedId = firstChecked.val();
                            $("input[name='MainCategoryId'][value='" + firstCheckedId + "']").prop("checked", true);
                        }
                    }
                }
            });

            // نمایش پیش‌فرض زیرگروه‌های انتخاب‌شده
            $(".category-checkbox:checked").each(function () {
                $(this).closest("li").children("ul").show();
            });

            // اطمینان از اینکه فقط دسته‌های انتخاب شده می‌توانند دسته اصلی باشند
            $("form").on("submit", function(e) {
                var mainCategorySelected = $("input[name='MainCategoryId']:checked").length > 0;
                var anyCategorySelected = $("input[name='SelectedCategoryIds']:checked").length > 0;

                if (!anyCategorySelected) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'خطا!',
                        text: 'لطفاً حداقل یک دسته‌بندی برای محصول انتخاب کنید'
                    });
                    return false;
                }

                if (anyCategorySelected && !mainCategorySelected) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'هشدار!',
                        text: 'لطفاً یک دسته به عنوان دسته اصلی محصول انتخاب کنید'
                    });
                    return false;
                }
            });
        });
    </script>





}
